# Leave unset for a locally built image; set to a published GHCR image to avoid building:
# PVE_ADMIN_IMAGE=ghcr.io/your-org/proxmox-admin:latest

# Endpoint must be a hostname or IP without https:// or :8006.
PROXMOX_HOST=pve1.example.org
PROXMOX_PORT=8006

# Individual admin's Proxmox token ID (not the secret): user@realm!tokenname
# API token SECRET goes into ~/.config/proxmox-admin/token (not this file).
PROXMOX_TOKEN_ID=operator@pve!admin-cli
PROXMOX_USER=operator@pve

# Keep TLS verification on. For self-signed certificates, use a CA bundle.
PROXMOX_VALIDATE_CERTS=true
# PROXMOX_CA_BUNDLE=/workspace/config/certs/ca-bundle.pem

# SSH username used in your Ansible inventory; same account must have SSH access.
PROXMOX_SSH_USER=root
